{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pai.axiomid.app/endpoint-schema.json",
  "title": "PAI Endpoint Schema",
  "type": "object",
  "required": ["endpoint", "layer", "name", "color", "routes", "skills", "i18n"],
  "properties": {
    "endpoint": {
      "type": "string",
      "pattern": "^[a-z]{3,8}$",
      "description": "Short endpoint key (vai, try, buy, fly, new, blg, induct, hai, bye, style, why, ppp)"
    },
    "layer": {
      "type": "string",
      "pattern": "^L[0-7]$"
    },
    "name": { "type": "string", "minLength": 1 },
    "arabic": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "component", "title"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "component": { "type": "string", "pattern": "^[A-Z][a-zA-Z0-9]*$" },
          "title": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z-]+$" }
    },
    "i18n": {
      "type": "object",
      "required": ["en", "ar", "zh"],
      "properties": {
        "en": { "$ref": "#/$defs/i18nBlock" },
        "ar": { "$ref": "#/$defs/i18nBlock" },
        "zh": { "$ref": "#/$defs/i18nBlock" }
      }
    }
  },
  "$defs": {
    "i18nBlock": {
      "type": "object",
      "required": ["hero_title", "hero_subtitle"],
      "properties": {
        "hero_title": { "type": "string" },
        "hero_subtitle": { "type": "string" },
        "cta_text": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}