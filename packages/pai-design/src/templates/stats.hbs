{{#if isClient}}"use client"{{/if}}

import { useStagger } from '@/lib/physics/stagger';

const stats = [
  { label: 'Endpoints', value: '{{routes.length}}' },
  { label: 'Skills', value: '{{skills.length}}' },
  { label: 'Languages', value: '3' },
];

export function {{endpoint.toUpperCase}}Stats() {
  const stagger = useStagger(0.06);
  return (
    <section className="py-16 bg-neutral-50 dark:bg-neutral-900">
      <div className="mx-auto max-w-5xl px-6">
        <dl className="grid grid-cols-1 md:grid-cols-3 gap-8">
          {{#each stats}}
          <dt className="text-center" style={{ opacity: stagger(@index) }}>
            <dd className="text-4xl/1 font-medium tracking-tight text-white">{{value}}</dd>
            <dt className="mt-1 font-mono text-[0.6875rem] font-medium tracking-[0.12em] text-neutral-500 uppercase">{{label}}</dt>
          </dt>
          {{/each}}
        </dl>
      </div>
    </section>
  );
}